{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": [
    "packages/**/*.ts",
    "tests/**/*.ts",
    "apps/**/*.ts",
    "playwright.config.ts"
  ],
  "exclude": [
    "node_modules",
    "**/node_modules/**",
    "apps/**/dist/**",
    "apps/web/.next/**",
    "apps/web/.next-e2e/**",
    "apps/web/.next-build/**"
  ]
}
