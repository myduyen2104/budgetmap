{
  "name": "budgetmap",
  "private": true,
  "allowScripts": {
    "@prisma/client": true,
    "@prisma/engines": true,
    "argon2": true,
    "prisma": true
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "vitest run tests/finance.test.ts tests/monthly-plan.test.ts tests/transfer-presentation.test.ts",
    "test:e2e": "DATABASE_URL=postgresql://budgetmap:budgetmap@127.0.0.1:5434/budgetmap_test?schema=public npm run db:test:migrate && node node_modules/@playwright/test/cli.js test tests/e2e/smoke.spec.ts tests/e2e/transfers.spec.ts",
    "test:a11y": "DATABASE_URL=postgresql://budgetmap:budgetmap@127.0.0.1:5434/budgetmap_test?schema=public npm run db:test:migrate && node node_modules/@playwright/test/cli.js test tests/e2e/a11y.spec.ts",
    "test:integration": "node scripts/run-integration.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p apps/web/tsconfig.json",
    "db:generate": "prisma generate --schema packages/api/prisma/schema.prisma",
    "db:validate": "prisma validate --schema packages/api/prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema packages/api/prisma/schema.prisma",
    "db:seed": "tsx packages/api/prisma/seed.ts",
    "db:test:migrate": "prisma migrate deploy --schema packages/api/prisma/schema.prisma",
    "db:seed:demo": "node --env-file=.env --import tsx scripts/seed-demo-data.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.0.0",
    "prisma": "6.19.3",
    "tsx": "4.23.13",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "@flaticon/flaticon-uicons": "^3.3.1"
  }
}
